		annotation SummarizationSetBy = User

	partition perfil_despesas_faixa_etaria = m
		mode: import
		source =
				let
				  Origem = Csv.Document(File.Contents(PastaOutput & "perfil_despesas_faixa_etaria.csv"), [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
				  #"O tipo de coluna foi alterado com a localidade" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"despesa_bruta_periodo", type number}, {"media_mensal_vidas", type number}, {"despesa_bruta_media_mensal", type number}, {"despesa_bruta_por_vida", type number}, {"participacao_vidas_pct", type number}, {"participacao_despesa_pct", type number}, {"Operadora", type text}, {"faixa_etaria", type text}, {"meses_observados", Int64.Type}}, "en-US")
				in
				  #"O tipo de coluna foi alterado com a localidade"

	annotation PBI_ResultType = Table

