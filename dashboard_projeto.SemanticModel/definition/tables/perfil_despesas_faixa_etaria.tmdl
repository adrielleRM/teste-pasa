/// Despesa bruta e vidas do período por operadora e faixa etária (exportado pelo notebook). Para cálculos mensais e despesa líquida use despesa_vidas_faixa_mensal.
table perfil_despesas_faixa_etaria
	lineageTag: ac688fa1-ed21-4df0-ba85-503c05be9e35

	column Operadora
		dataType: string
		isHidden
		lineageTag: 0ca5c6b3-bfaa-4b28-917d-ccce6c066e21
		summarizeBy: none
		sourceColumn: Operadora

		annotation SummarizationSetBy = Automatic

	column faixa_etaria
		dataType: string
		isHidden
		lineageTag: 9a713d97-79a2-4f97-b5c9-bb54dc2c7c8a
