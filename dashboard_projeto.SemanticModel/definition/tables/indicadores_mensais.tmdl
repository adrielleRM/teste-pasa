	partition indicadores_mensais = m
		mode: import
		source =
				let
				  Origem = Csv.Document(File.Contents(PastaOutput & "indicadores_mensais.csv"), [Delimiter = ",", Columns = 12, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
				  #"Tipos alterados" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"Operadora", type text}, {"data_ref", type date}, {"despesa_bruta", type number}, {"coparticipacao", type number}, {"despesa_liquida", type number}, {"registros", Int64.Type}, {"registros_liquidos_negativos", Int64.Type}, {"vidas", Int64.Type}, {"receita", type number}, {"sinistralidade_pct", type number}, {"roi_pct", type number}, {"custo_per_capita_mensal", type number}}, "en-US")
				in
