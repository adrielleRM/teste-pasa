/// Fato mensal por operadora (grão: Operadora x data_ref). Colunas ocultas: use as medidas de _Medidas. As colunas de razão (sinistralidade_pct, roi_pct, custo_per_capita_mensal) não devem ser somadas nem promediadas.
table indicadores_mensais
	lineageTag: b3f25d5a-e725-4bd0-b10d-0efc9d53fe76

	column Operadora
		dataType: string
		isHidden
		lineageTag: 84433c0e-f12d-4e3d-9195-f550ac9944b2
		summarizeBy: none
		sourceColumn: Operadora

		annotation SummarizationSetBy = Automatic

	column data_ref
